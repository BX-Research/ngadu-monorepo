{
  "name": "sporting-bxb",
  "private": true,
  "packageManager": "bun@1.4.3",
  "scripts": {
    "setup:frontend": "bun install --cwd bxbeloy-fe --frozen-lockfile",
    "dev": "bun run --cwd bxbeloy-fe --bun dev",
    "build": "bun run --cwd bxbeloy-fe --bun build",
    "start": "bun run --cwd bxbeloy-fe --bun start",
    "lint": "bun run --cwd bxbeloy-fe --bun lint",
    "typecheck": "bun run --cwd bxbeloy-fe --bun tsc --noEmit"
  }
}
