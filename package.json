{
  "name": "ngadu-monorepo",
  "private": true,
  "packageManager": "bun@1.4.3",
  "scripts": {
    "setup:frontend": "bun install --cwd frontend --frozen-lockfile",
    "dev": "bun run --cwd frontend --bun dev",
    "build": "bun run --cwd frontend --bun build",
    "start": "bun run --cwd frontend --bun start",
    "lint": "bun run --cwd frontend --bun lint",
    "typecheck": "bun run --cwd frontend --bun tsc --noEmit",
    "setup:hooks": "git config --local core.hooksPath .githooks"
  }
}
