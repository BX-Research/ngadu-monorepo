# Required local database settings. Copy to root .env locally.
# These are development placeholders, not production credentials.
DEV_DB_USER=ngadu
DEV_DB_PASSWORD=change-me-local-only
DEV_DB_NAME=ngadu_dev
DEV_DB_PORT=5432
PORT=8080
# Required for direct air/go startup; Make overrides this for local development.
DATABASE_URL=postgresql://ngadu:change-me-local-only@127.0.0.1:5432/ngadu_dev?sslmode=disable

# SeaweedFS local S3. Published development placeholders, never cloud credentials.
DEV_S3_PORT=8333
DEV_S3_BUCKET=ngadu-dev
DEV_S3_REGION=us-east-1
DEV_S3_ACCESS_KEY=ngadu-local
DEV_S3_SECRET_KEY=change-me-local-storage-only
# The leaderboard is available by default. Server-only Next.js overrides:
# NGADU_BACKEND_ORIGIN=http://127.0.0.1:8080
