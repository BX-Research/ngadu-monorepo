# Required local database settings. Copy to root .env locally.
# These are development placeholders, not production credentials.
DEV_DB_USER=ngadu
DEV_DB_PASSWORD=change-me-local-only
DEV_DB_NAME=ngadu_dev
PORT=8080
# Required for direct air/go startup; Make overrides this for local development.
DATABASE_URL=postgresql://ngadu:change-me-local-only@127.0.0.1:5432/ngadu_dev?sslmode=disable
